<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.pharmacymanagmentsystem.controller.GRNController">
   <children>
      <AnchorPane>
         <children>
            <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               
               <!-- CENTER CONTENT -->
               <center>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: #E3FDFD;" BorderPane.alignment="CENTER">
                     <content>
                        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #E3FDFD;">
                           
                           <!-- HEADER SECTION -->
                           <VBox prefHeight="138.0" prefWidth="866.0" spacing="10" style="-fx-background-color: #fafafa; -fx-border-color: #71C9CE; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;">
                              <children>
                                 <Label style="-fx-text-fill: #0288a0; -fx-font-size: 14; -fx-font-weight: bold;" text="GRN Header Details">
                                    <font>
                                       <Font name="System Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Separator />
                                 
                                 <HBox spacing="30">
                                    <children>
                                       <!-- Supplier -->
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Supplier:" />
                                             <ComboBox fx:id="supplierCombo" maxWidth="Infinity" promptText="Select Supplier" style="-fx-padding: 10; -fx-font-size: 12;">
                                                <tooltip>
                                                   <Tooltip text="Select the supplier for this GRN" />
                                                </tooltip>
                                             </ComboBox>
                                          </children>
                                       </VBox>
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="Reference Number (PO/Invoice):" />
                                             <TextField fx:id="referenceNumberField" maxWidth="Infinity" promptText="e.g., PO-2025-001 or INV-12345" style="-fx-padding: 10; -fx-font-size: 12;">
                                                <tooltip>
                                                   <Tooltip text="Supplier Purchase Order or Invoice number" />
                                                </tooltip>
                                             </TextField>
                                          </children>
                                       </VBox>
                                    </children>
                                 </HBox>
                                 <HBox spacing="20" />
                              </children>
                           </VBox>
                           
                           <!-- LINE ITEMS SECTION -->
                           <VBox prefWidth="866.0" spacing="10" style="-fx-background-color: #fafafa; -fx-border-color: #71C9CE; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                              <children>
                                 <Label style="-fx-text-fill: #0288a0; -fx-font-size: 14; -fx-font-weight: bold;" text="Line Items">
                                    <font>
                                       <Font name="System Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Separator />
                                 
                                 <!-- Add Line Section -->
                                 <VBox spacing="10" style="-fx-background-color: #CBF1F5; -fx-border-color: #71C9CE; -fx-border-width: 2; -fx-border-radius: 3; -fx-padding: 12;">
                                    <children>
                                       <Label style="-fx-font-weight: bold; -fx-text-fill: #0288a0; -fx-font-size: 12;" text="Add New Line Item" />
                                       
                                       <!-- First Row -->
                                       <HBox spacing="10">
                                          <children>
                                             <VBox prefHeight="59.0" prefWidth="0.0" spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Product:" />
                                                   <ComboBox fx:id="lineProductCombo" maxWidth="Infinity" promptText="Select Product" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                             <VBox prefHeight="59.0" prefWidth="92.0" spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Batch Number:" />
                                                   <TextField fx:id="lineBatchNumberField" maxWidth="Infinity" promptText="e.g., BATCH001" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                             <VBox prefHeight="59.0" prefWidth="68.0">
                                                <children>
                                                   <Button mnemonicParsing="false" onAction="#handleAutoGenerateBatch" prefHeight="26.0" prefWidth="62.0" text="🔄Auto">
                                                      <VBox.margin>
                                                         <Insets top="23.0" />
                                                      </VBox.margin>
                                                   </Button>
                                                </children>
                                             </VBox>
                                             <VBox spacing="3">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Expiry Date:" />
                                                   <DatePicker fx:id="lineExpiryDatePicker" maxWidth="Infinity" prefHeight="40.0" prefWidth="215.0" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                          </children>
                                       </HBox>
                                       
                                       <!-- Second Row -->
                                       <HBox spacing="10">
                                          <children>
                                             <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Manufacture Date (Optional):" />
                                                   <DatePicker fx:id="lineManufactureDatePicker" maxWidth="Infinity" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                             <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Quantity:" />
                                                   <TextField fx:id="lineQtyField" maxWidth="Infinity" promptText="0" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                             <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Cost Price:" />
                                                   <TextField fx:id="lineCostPriceField" maxWidth="Infinity" promptText="0.00" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                             <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                <children>
                                                   <Label style="-fx-font-weight: bold; -fx-text-fill: #424242; -fx-font-size: 11;" text="Selling Price:" />
                                                   <TextField fx:id="lineSellingPriceField" maxWidth="Infinity" promptText="0.00" style="-fx-padding: 8; -fx-font-size: 11;" />
                                                </children>
                                             </VBox>
                                          </children>
                                       </HBox>
                                       
                                       <!-- Add Button -->
                                       <HBox spacing="10">
                                          <children>
                                             <Button fx:id="addLineButton" onAction="#handleAddLine" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #71C9CE; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="Add Line" />
                                             <Button fx:id="resetLineButton" onAction="#handleResetLine" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #FF9800; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="Clear" />
                                             <Separator orientation="VERTICAL" HBox.hgrow="ALWAYS" />
                                          </children>
                                       </HBox>
                                    </children>
                                 </VBox>
                                 
                                 <!-- Line Items Table -->
                                 <Label style="-fx-font-weight: bold; -fx-text-fill: #0288a0; -fx-font-size: 12;" text="Added Items :" />
                                 <TableView fx:id="lineItemsTable" style="-fx-font-size: 11;" VBox.vgrow="ALWAYS">
                                    <columns>
                                       <TableColumn fx:id="lineNoCol" prefWidth="40" style="-fx-font-weight: bold;" text="No" />
                                       <TableColumn fx:id="lineProductCol" prefWidth="120" style="-fx-font-weight: bold;" text="Product" />
                                       <TableColumn fx:id="lineBatchCol" prefWidth="100" style="-fx-font-weight: bold;" text="Batch #" />
                                       <TableColumn fx:id="lineExpiryCol" prefWidth="90" style="-fx-font-weight: bold;" text="Expiry" />
                                       <TableColumn fx:id="lineMfgCol" prefWidth="90" style="-fx-font-weight: bold;" text="Mfg Date" />
                                       <TableColumn fx:id="lineQtyCol" prefWidth="70" style="-fx-font-weight: bold;" text="Qty" />
                                       <TableColumn fx:id="lineCostCol" prefWidth="80" style="-fx-font-weight: bold;" text="Cost Price" />
                                       <TableColumn fx:id="lineSellCol" prefWidth="80" style="-fx-font-weight: bold;" text="Sell Price" />
                                       <TableColumn fx:id="lineTotalCol" prefWidth="90" style="-fx-font-weight: bold;" text="Line Total" />
                                       <TableColumn fx:id="lineActionsCol" prefWidth="70" style="-fx-font-weight: bold;" text="Actions" />
                                    </columns>
                                    <columnResizePolicy>
                                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                 </TableView>
                              </children>
                           </VBox>
                           
                           <!-- SUMMARY SECTION -->
                           <HBox spacing="20" style="-fx-padding: 20; -fx-background-color: #A6E3E9; -fx-border-color: #71C9CE; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;">
                              <children>
                                 <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: black;" text="Total Items:" />
                                             <Label fx:id="totalItemsLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: black;" text="0" />
                                          </children>
                                       </HBox>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: black;" text="Total Quantity:" />
                                             <Label fx:id="totalQtyLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: black;" text="0" />
                                          </children>
                                       </HBox>
                                    </children>
                                 </VBox>
                                 
                                 <Separator orientation="VERTICAL" />
                                 
                                 <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: black;" text="Total Cost Value:" />
                                             <Label fx:id="totalCostLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #d32f2f;" text="Rs. 0.00" />
                                          </children>
                                       </HBox>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: black;" text="Total Selling Value:" />
                                             <Label fx:id="totalSellingLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: blue;" text="Rs. 0.00" />
                                          </children>
                                       </HBox>
                                    </children>
                                 </VBox>
                                 
                                 <Separator orientation="VERTICAL" />
                                 
                                 <VBox spacing="10" HBox.hgrow="ALWAYS">
                                    <children>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: black;" text="Profit Margin:" />
                                             <Label fx:id="profitMarginLabel" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: black;" text="Rs. 0.00" />
                                          </children>
                                       </HBox>
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: black;" text="Margin %:" />
                                             <Label fx:id="profitPercentLabel" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: green;" text="0.00 %" />
                                          </children>
                                       </HBox>
                                    </children>
                                 </VBox>
                              </children>
                           </HBox>
                           
                           <!-- ACTION BUTTONS -->
                           <HBox spacing="10" style="-fx-padding: 10;">
                              <children>
                                 <Button fx:id="saveGRNButton" onAction="#handleSaveGRN" style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #71C9CE; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="Save GRN" HBox.hgrow="ALWAYS" />
                              </children>
                           </HBox>
                        </VBox>
                     </content>
                  </ScrollPane>
               </center>
               <top>
                  <HBox prefHeight="69.0" prefWidth="908.0" style="-fx-background-color: #71C9CE; -fx-background-radius: 15;" BorderPane.alignment="CENTER">
                     <children>
                        <Label prefHeight="47.0" prefWidth="430.0" text="Goods Received Note (GRN)">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="10.0" top="10.0" />
                           </HBox.margin>
                        </Label>
                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <Label prefHeight="18.0" prefWidth="88.0" style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="GRN Number:">
                           <HBox.margin>
                              <Insets left="20.0" top="25.0" />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="grnNumberField" disable="true" maxWidth="Infinity" prefHeight="38.0" prefWidth="134.0" promptText="Auto-generated" style="-fx-padding: 10; -fx-font-size: 12;">
                           <tooltip>
                              <Tooltip text="GRN number will be auto-generated" />
                           </tooltip>
                           <HBox.margin>
                              <Insets right="10.0" top="15.0" />
                           </HBox.margin>
                        </TextField>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #424242;" text="GRN Date:">
                           <HBox.margin>
                              <Insets top="25.0" />
                           </HBox.margin>
                        </Label>
                        <DatePicker fx:id="grnDatePicker" maxWidth="Infinity" prefHeight="37.0" prefWidth="157.0" style="-fx-padding: 10; -fx-font-size: 12;">
                           <tooltip>
                              <Tooltip text="Date of goods receipt" />
                           </tooltip>
                           <HBox.margin>
                              <Insets right="10.0" top="10.0" />
                           </HBox.margin>
                        </DatePicker>
                     </children>
                     <BorderPane.margin>
                        <Insets />
                     </BorderPane.margin>
                  </HBox>
               </top>
            </BorderPane>
         </children>
      </AnchorPane>
   </children>
   <padding>
      <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
   </padding>
</StackPane>
