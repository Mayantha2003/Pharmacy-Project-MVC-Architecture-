                                 <Button fx:id="printInvoiceButton" onAction="#handlePrintButtonAction" style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #2196F3; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="Print" HBox.hgrow="ALWAYS" />
                                 <Button fx:id="resetFormButton" onAction="#handleResetForm" style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #FF9800; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="Reset Form" HBox.hgrow="ALWAYS" />
