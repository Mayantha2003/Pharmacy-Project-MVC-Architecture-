                                 <Button onAction="#handleViewLastInvoice" style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #2196F3; -fx-text-fill: black; -fx-font-weight: bold; -fx-border-radius: 3;" text="View Last Invoice">
