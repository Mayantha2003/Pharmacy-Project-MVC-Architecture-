                                             <Label style="-fx-font-weight: bold; -fx-text-fill: black;" text="Paid Amount:" />
                                             <TextField fx:id="paidAmountField" maxWidth="600.0" promptText="0.00" style="-fx-padding: 8; -fx-font-size: 11;" />
                                          </children>
                                       </VBox>
                                       <Separator />
                                       <HBox spacing="10">
                                          <children>
                                             <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: black;" text="Balance:" />
                                             <Label fx:id="balanceLabel" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: black;" text="Rs. 0.00" />
                                          </children>
                                       </HBox>
                                    </children>
                                 </VBox>
