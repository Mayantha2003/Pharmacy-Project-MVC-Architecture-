<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.pharmacymanagmentsystem.controller.ProductController">
   <children>
      <AnchorPane prefHeight="779.0" prefWidth="947.0">
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
         <children>
            <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <top>
                  <HBox prefHeight="80.0" style="-fx-background-color: #71C9CE; -fx-background-radius: 15;" BorderPane.alignment="CENTER">
                     <children>
                        <Label text="Product Management" HBox.hgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="32.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="10.0" top="17.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                     <BorderPane.margin>
                        <Insets top="4.0" />
                     </BorderPane.margin>
                  </HBox>
               </top>
               <center>
                  <HBox style="-fx-background-color: #E3FDFD; -fx-background-radius: 15; -fx-padding: 7;" BorderPane.alignment="CENTER">
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <children>
                        <VBox maxWidth="400.0" minWidth="300.0" prefHeight="692.0" spacing="5" style="-fx-background-color: #fafafa; -fx-border-color: #71C9CE; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #0288a0;" text="Add New Product">
                                 <font>
                                    <Font name="System Bold" size="16.0" />
                                 </font>
                              </Label>
                              <VBox spacing="10">
                                 <children>
                                    <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0288a0;" text="General Information" />
                                    <Separator prefWidth="200.0" />
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Product Code:" />
                                          <TextField fx:id="codeField" promptText="e.g., BAR001" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Product Name:" />
                                          <TextField fx:id="nameField" promptText="e.g., Panadol 500mg" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Pack Size:" />
                                          <TextField fx:id="packSizeField" promptText="e.g., 10x10, 100ml" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Category:" />
                                          <ComboBox fx:id="categoryCombo" maxWidth="Infinity" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0288a0;" text="Medicine Information" />
                                    <Separator />
                                    <CheckBox fx:id="medicineCheckBox" style="-fx-font-size: 11; -fx-font-weight: bold;" text="This is a medicine" />
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Generic Name:" />
                                          <TextField fx:id="genericNameField" disable="true" promptText="e.g., Paracetamol" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Strength:" />
                                          <TextField fx:id="strengthField" disable="true" promptText="e.g., 500mg" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Dosage Form:" />
                                          <ComboBox fx:id="dosageFormCombo" disable="true" maxWidth="Infinity" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="3">
                                       <children>
                                          <Label style="-fx-font-weight: bold;" text="Manufacturer:" />
                                          <TextField fx:id="companyField" disable="true" promptText="e.g., GlaxoSmithKline" style="-fx-padding: 8;" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox spacing="10.0" style="-fx-padding: 5;" HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets left="5.0" />
                           </HBox.margin>
                           <children>
                              <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ffffff; -fx-border-radius: 5; -fx-border-color: #71C9CE; -fx-border-width: 1;">
                                 <children>
                                    <Label style="-fx-font-weight: bold;" text="Search:">
                                       <HBox.margin>
                                          <Insets top="7.0" />
                                       </HBox.margin>
                                    </Label>
                                    <TextField fx:id="searchField" onKeyPressed="#handleSearchProduct" promptText="Search by name or code..." style="-fx-padding: 8;" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="searchButton" onAction="#handleSearchProduct" style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #71C9CE; -fx-text-fill: white;" text="🔍 Search" />
                                 </children>
                              </HBox>
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0288a0;" text="Product List" />
                              <TableView fx:id="productTable" prefHeight="504.0" prefWidth="618.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="idCol" prefWidth="50" style="-fx-font-weight: bold;" text="ID" />
                                    <TableColumn fx:id="codeCol" prefWidth="80" style="-fx-font-weight: bold;" text="Code" />
                                    <TableColumn fx:id="nameCol" prefWidth="150" style="-fx-font-weight: bold;" text="Product Name" />
                                    <TableColumn fx:id="packCol" prefWidth="80" style="-fx-font-weight: bold;" text="Pack Size" />
                                    <TableColumn fx:id="catCol" prefWidth="90" style="-fx-font-weight: bold;" text="Category" />
                                    <TableColumn fx:id="actionsCol" prefWidth="90" style="-fx-font-weight: bold;" text="Actions" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox spacing="10" style="-fx-padding: 5;">
                                 <children>
                                    <Button fx:id="editButton" onAction="#handleSaveProduct" prefHeight="45.0" prefWidth="98.0" style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #71C9CE; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10;" text="Save" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="editButton1" onAction="#handleUpdateProduct" prefHeight="45.0" prefWidth="98.0" style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #FF9800; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10;" text="Update" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </center>
            </BorderPane>
         </children>
      </AnchorPane>
   </children>
</StackPane>
