	<query language="SQL"><![CDATA[SELECT 
    p.code AS item_code, 
    p.name AS medicine_name, 
    p.generic_name, 
    c.name AS category, 
    p.company, 
    s.supplier_name, 
    SUM(b.qty_remaining) AS total_qty
FROM Products p
JOIN Batches b ON p.product_id = b.product_id
JOIN Categories c ON p.cat_id = c.cat_id
JOIN Suppliers s ON b.supplier_id = s.supplier_id
GROUP BY p.product_id, p.code, p.name, p.generic_name, c.name, p.company, s.supplier_name
HAVING total_qty <= 10
ORDER BY total_qty ASC]]></query>
