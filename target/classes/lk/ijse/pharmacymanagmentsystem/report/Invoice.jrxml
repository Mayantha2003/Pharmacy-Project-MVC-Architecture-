	<dataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="Discount" class="java.math.BigDecimal"/>
	<parameter name="invoiceId" class="java.lang.Long"/>
	<query language="sql"><![CDATA[SELECT 
    i.invoice_number, 
    i.invoice_date, 
    COALESCE(c.name, 'Cash Sale') AS customer_name, 
    c.contact AS customer_contact,
    p.name AS product_name, 
    p.code AS product_code,
    b.batch_number, 
    b.expiry_date,
    id.quantity, 
    id.selling_price, 
    id.line_total,
    i.total_amount AS total_amount, 
    i.paid_amount, 
    i.balance,
    u.username,
    (SELECT payment_method FROM Invoice_Payment WHERE invoice_id = i.invoice_id LIMIT 1) AS payment_method
FROM Invoice i
LEFT JOIN Customers c ON i.customer_id = c.customer_id
JOIN Invoice_Details id ON i.invoice_id = id.invoice_id
JOIN Batches b ON id.batch_id = b.batch_id
JOIN Products p ON b.product_id = p.product_id
JOIN Users u ON i.cashier_id = u.user_id
WHERE i.invoice_id = $P{invoiceId}
ORDER BY id.invoice_detail_id]]></query>
